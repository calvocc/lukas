# ==========================================
# Variables de Entorno - Lukas Bot v1
# ==========================================

# Canal de Mensajería: cli | baileys | cloud_api
CANAL_PROVEEDOR=cli
REGISTRO_MODO=abierto
ADMIN_EMAIL=admin@lukas.local

# Inteligencia Artificial (Intérprete)
IA_PROVEEDOR=openai
IA_MODELO=gpt-4o-mini
OPENAI_API_KEY=tu_api_key_de_openai_aqui

# Base de Datos PostgreSQL (Docker local)
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=lukas_db
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5434/lukas_db

# Formato y Moneda
MONEDA_DEFAULT=COP
ZONA_HORARIA_DEFAULT=America/Bogota
HORA_RECORDATORIOS_DEFAULT=08:00
